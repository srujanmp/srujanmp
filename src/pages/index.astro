---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import portraitGreen from '../assets/photos/portrait-green.jpg';
import sofa from '../assets/photos/sofa.jpg';
import kurtaWall from '../assets/photos/kurta-wall.jpg';
import ghatsRoad from '../assets/photos/ghats-road.jpg';
import ghatsWide from '../assets/photos/ghats-wide.jpg';
import throne from '../assets/photos/throne.jpg';
import nmamitLogo from '../assets/logos/nmamit.png';
import vidyodayaLogo from '../assets/logos/vidyodaya.png';
import gmvpsLogo from '../assets/logos/gmvps.png';

const projects = await getCollection('projects');

const stack = [
  'Go', 'JavaScript', 'Node.js', 'PostgreSQL', 'Redis', 'Docker',
  'RabbitMQ', 'WebRTC', 'React', 'Next.js', 'MongoDB', 'Socket.IO',
  'Flutter', 'Godot Engine', 'Git',
];

const stats = [
  { value: '8.9', label: 'CGPA' },
  { value: String(projects.length), label: 'Projects' },
  { value: '1', label: 'Internship' },
  { value: '2027', label: 'Graduating' },
];

const education = [
  {
    course: 'BTech, Information Science & Engineering',
    school: 'NMAM Institute of Technology, Nitte',
    years: '2023 - 2027',
    score: 'CGPA 8.9',
    logo: nmamitLogo,
  },
  {
    course: 'Class 11 & 12',
    school: 'Vidyodaya College',
    years: '2023',
    score: '94%',
    logo: vidyodayaLogo,
  },
  {
    course: 'Class 10',
    school: 'GMVPS',
    years: '2020',
    score: '90%',
    logo: gmvpsLogo,
  },
];

const achievements = [
  'Organized Cipher Chase, a technical event for 50+ participants at College Fest 2025.',
  'Top 10 in the Hackloop internal hackathon.',
  '9th rank in the NCAT aptitude exam, 2024.',
  'Participated in and volunteered at coding contests, workshops and competitions.',
  'Active member of the coding club and the branch club.',
];

const currentYear = new Date().getFullYear();
const startYear = 2005;

// A year can hold more than one event; `month` labels it when that matters.
type Milestone = { text: string; month?: string; photo?: ImageMetadata; alt?: string };

const milestones: Record<number, Milestone[]> = {
  2005: [{ text: 'Spawned on 21 Sep' }],
  2009: [{ text: 'LKG' }],
  2010: [{ text: 'UKG' }],
  2011: [{ text: 'Class 1' }],
  2013: [{ text: 'First real interest in tech' }],
  2015: [{ text: "Inherited my grandfather's old laptop" }],
  2019: [{ text: 'COVID-19' }],
  2020: [{ text: 'Finished Class 10' }],
  2021: [{ text: 'PUC - PCMC with Computer Science' }],
  2023: [
    {
      text: 'Started BTech ISE at NMAMIT',
      photo: kurtaWall,
      alt: 'Srujan in a white kurta outside a village house',
    },
  ],
  2024: [{ text: 'New laptop. Things got serious' }],
  2025: [{ text: 'Organized Cipher Chase at College Fest' }],
  2026: [
    {
      month: 'Apr',
      text: 'Internship at Comcent.io - built a SIP phone in Flutter',
      photo: ghatsRoad,
      alt: 'Srujan on a hill road in the Western Ghats',
    },
  ],
  2027: [{ text: 'BTech graduation' }, { month: 'Aug', text: 'Joining' }],
};

// Every year from birth to graduation - continuous, no gaps.
const endYear = Math.max(currentYear, ...Object.keys(milestones).map(Number));
const timeline = Array.from({ length: endYear - startYear + 1 }, (_, i) => {
  const year = startYear + i;
  return { year, events: milestones[year] ?? [], future: year > currentYear };
});

const gallery = [
  { src: ghatsWide, alt: 'Srujan in the Western Ghats with mountains behind', caption: 'Agumbe, the good kind of offline', span: 'sm:col-span-2' },
  { src: throne, alt: 'Srujan sitting in an ornate wooden chair', caption: 'Found a throne. Sat in it', span: '' },
];
---

<Layout title="Srujan M Padmashali - Backend Developer">
  <!-- ====================== HERO ====================== -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center pt-4 pb-20 sm:pb-28">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <p class="eyebrow mb-5" data-rise="1">Backend · System design · Bengaluru, IN</p>

      <h1 class="display text-[clamp(2.75rem,9vw,5.5rem)] text-ink mb-6" data-rise="2">
        Srujan M<br /><span class="text-accent">Padmashali</span>
      </h1>

      <p class="text-lg sm:text-xl text-ink-2 leading-relaxed max-w-xl mb-8" data-rise="3">
        I build backend systems that hold under load - mostly in
        <span class="text-ink font-medium">Node.js</span>. Microservices, Devops,
        Design, Books and the occasional game engine when I get bored.
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3" data-rise="4">
        <a
          href="/projects"
          data-astro-prefetch="hover"
          class="inline-flex items-center gap-2 bg-ink text-canvas px-5 py-2.5 rounded-full mono text-[13px] hover:bg-accent transition-colors duration-300"
        >
          See my work
          <span aria-hidden="true">→</span>
        </a>
        <a href="mailto:srujanmpadmashali@gmail.com" class="link mono text-[13px] text-ink-2 hover:text-accent transition-colors">Email</a>
        <a href="https://github.com/srujanmp" target="_blank" rel="noopener noreferrer" class="link mono text-[13px] text-ink-2 hover:text-accent transition-colors">GitHub</a>
        <a href="https://linkedin.com/in/srujanmpadmashali" target="_blank" rel="noopener noreferrer" class="link mono text-[13px] text-ink-2 hover:text-accent transition-colors">LinkedIn</a>
        <a href="https://leetcode.com/u/srujanmpadmashali" target="_blank" rel="noopener noreferrer" class="link mono text-[13px] text-ink-2 hover:text-accent transition-colors">LeetCode</a>
      </div>
    </div>

    <div class="lg:col-span-5 order-1 lg:order-2" data-rise="2">
      <div class="relative max-w-[300px] sm:max-w-[340px] mx-auto lg:mx-0 lg:ml-auto">
        <div class="frame-offset">
          <div class="frame aspect-[3/4]">
            <Image
              src={portraitGreen}
              alt="Srujan M Padmashali"
              widths={[340, 680]}
              sizes="(max-width: 1024px) 340px, 340px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <p class="mono text-[11px] text-ink-3 mt-5 lg:text-right">
          <span class="text-accent">◆</span> Udupi, Karnataka
        </p>
      </div>
    </div>
  </section>

  <!-- ====================== STACK MARQUEE ====================== -->
  <section class="border-y border-line py-4 -mx-5 sm:-mx-8 px-0 mb-20 sm:mb-28" aria-label="Technology stack">
    <div class="marquee">
      {
        [0, 1].map((copy) => (
          <div class="marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {stack.map((item) => (
              <span class="mono text-[13px] text-ink-2 whitespace-nowrap flex items-center gap-2.5">
                {item}
                <span class="text-accent/50" aria-hidden="true">/</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ====================== ABOUT ====================== -->
  <section class="mb-20 sm:mb-28" data-reveal>
    <SectionHeading label="About" />

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-7 space-y-5">
        <p class="text-lg leading-relaxed text-ink-2">
          Hey, I'm Srujan. I'm a final-year student who spends most of his time
          pondering problems - and creating new ones. I think in terms of system
          design, picking up new technologies and adapting to a changing world.
        </p>
        <p class="text-base leading-relaxed text-ink-2">
          I like measurable change. Taking applications all the way to production
          is the part I'm most interested in.
        </p>
        <p class="text-base leading-relaxed text-ink-2">
          Outside that, I'm learning new tools and reading programming books.
        </p>
        <p class="text-base leading-relaxed text-ink-2">
          I keep it simple, make it work, then make it fast.
        </p>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-line border border-line mt-10 rounded overflow-hidden">
          {
            stats.map((stat) => (
              <div class="bg-canvas px-4 py-5">
                <dt class="mono text-[10px] uppercase tracking-[0.15em] text-ink-3 mb-2 leading-tight">{stat.label}</dt>
                <dd class="display text-3xl text-ink">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="md:col-span-5">
        <div class="frame aspect-[6/5]" style="--focus:50% 100%">
          <Image src={sofa} alt="Srujan sitting on a sofa" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================== EDUCATION ====================== -->
  <section class="mb-20 sm:mb-28" data-reveal>
    <SectionHeading label="Education" />

    <div class="flex flex-col gap-7">
      {
        education.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-6 border-l-2 border-accent pl-6 py-1">
            <div class="flex items-center gap-4 min-w-0">
              <Image
                src={item.logo}
                alt=""
                widths={[44, 88]}
                sizes="44px"
                loading="lazy"
                class="w-11 h-11 object-contain shrink-0"
              />
              <div class="min-w-0">
                <h3 class="text-xl text-ink font-medium mb-1">{item.course}</h3>
                <p class="text-ink-2">{item.school}</p>
              </div>
            </div>
            <div class="sm:text-right shrink-0 pl-15 sm:pl-0">
              <p class="mono text-[13px] text-ink-2">{item.years}</p>
              <p class="mono text-[13px] text-accent">{item.score}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ====================== TIMELINE ====================== -->
  <section class="mb-20 sm:mb-28" id="timeline">
    <SectionHeading label="Timeline" />

    <div id="timeline-rail" class="relative">
      <!-- vertical rail, centred in the gutter between the year and event columns -->
      <div class="timeline-line absolute top-0 bottom-0 w-px bg-line-2" aria-hidden="true"></div>
      <div id="timeline-progress" class="timeline-line absolute top-0 w-px bg-accent" style="height:0" aria-hidden="true"></div>

      {
        timeline.map((item) => (
          <article
            class={`timeline-row relative grid grid-cols-[3.5rem_1fr] gap-x-8 items-center ${
              item.events.length ? 'py-3.5' : 'py-1'
            }`}
            data-year={item.year}
          >
            <span
              class={`timeline-year mono text-[13px] tabular-nums text-right transition-colors duration-300 ${
                item.events.length ? 'text-ink-2' : 'text-ink-3/45'
              }`}
            >
              {item.year}
            </span>

            <span
              class={`timeline-dot absolute rounded-full bg-line-2 transition-all duration-300 ${
                item.events.length ? 'w-2 h-2' : 'w-1 h-1'
              }`}
              aria-hidden="true"
            />

            {item.events.length ? (
              <div class="flex flex-col gap-2.5 min-w-0">
                {item.events.map((event, eventIndex) => (
                  <div class="flex items-center gap-4 min-w-0">
                    {event.photo && (
                      <div class="frame w-14 h-[4.5rem] sm:w-16 sm:h-20 shrink-0">
                        <Image src={event.photo} alt={event.alt ?? ''} widths={[64, 128]} sizes="64px" loading="lazy" />
                      </div>
                    )}
                    <p class={`text-base leading-snug ${item.future ? 'text-ink-3' : 'text-ink'}`}>
                      {event.month && <span class="mono text-[11px] text-ink-3 mr-2">{event.month}</span>}
                      {event.text}
                      {item.future && eventIndex === 0 && (
                        <span class="mono text-[11px] text-accent ml-2">upcoming</span>
                      )}
                    </p>
                  </div>
                ))}
              </div>
            ) : (
              <span />
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- ====================== ACHIEVEMENTS ====================== -->
  <section class="mb-20 sm:mb-28" data-reveal>
    <SectionHeading label="Achievements" />

    <ul class="flex flex-col gap-4">
      {
        achievements.map((item) => (
          <li class="flex gap-4 items-baseline">
            <span class="text-accent shrink-0" aria-hidden="true">◆</span>
            <span class="text-base leading-relaxed text-ink-2">{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ====================== GALLERY ====================== -->
  <section data-reveal>
    <SectionHeading label="Off the clock" />

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {
        gallery.map((shot) => (
          <figure class={shot.span}>
            <div class={`frame ${shot.span ? 'aspect-[16/10]' : 'aspect-[3/4]'}`}>
              <Image src={shot.src} alt={shot.alt} widths={[400, 800, 1200]} sizes="(max-width: 640px) 100vw, 45vw" loading="lazy" />
            </div>
            <figcaption class="mono text-[11px] text-ink-3 mt-3">{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  /* Year column is 3.5rem, gutter is 2rem → rail sits at 4.5rem. */
  .timeline-line {
    left: 4.5rem;
  }

  .timeline-dot {
    left: calc(4.5rem - 0.25rem);
    top: 50%;
    translate: 0 -50%;
  }

  /* Filler years use the smaller 1rem dot, so re-centre it. */
  .timeline-row:not(:has(p)) .timeline-dot {
    left: calc(4.5rem - 0.125rem);
  }

  .timeline-row.is-active .timeline-year {
    color: var(--color-accent);
  }

  .timeline-row.is-active .timeline-dot {
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }
</style>

<script>
  const setupTimeline = () => {
    const rail = document.getElementById('timeline-rail');
    const progress = document.getElementById('timeline-progress');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.timeline-row'));

    if (!rail || !progress || !rows.length) return;

    let queued = false;

    const update = () => {
      queued = false;
      const rect = rail.getBoundingClientRect();
      const anchor = window.innerHeight * 0.45;

      const filled = Math.max(0, Math.min(anchor - rect.top, rect.height));
      progress.style.height = `${filled}px`;

      const cutoff = rect.top + filled;
      for (const row of rows) {
        const rowRect = row.getBoundingClientRect();
        const center = rowRect.top + rowRect.height / 2;
        row.classList.toggle('is-active', center <= cutoff + 8 && center >= cutoff - 48);
      }
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    window.__timelineCleanup?.();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.__timelineCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };

    update();
  };

  document.addEventListener('astro:page-load', setupTimeline);
</script>
