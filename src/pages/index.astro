---
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Automatic Payment</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
      body {
        font-family: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#F2D750] text-[#191A19] antialiased min-h-screen p-4 sm:p-8 flex items-center justify-center">

    <div class="max-w-[1300px] w-full bg-[#FAF7EF] rounded-[40px] border-[12px] border-[#191A19] p-8 relative overflow-hidden shadow-2xl">

      <!-- Navbar -->
      <nav class="flex flex-col lg:flex-row justify-between items-center mb-10 gap-6">
        <div class="text-3xl font-bold tracking-tighter">qb</div>

        <div class="flex flex-wrap justify-center bg-[#191A19] text-white rounded-full p-1.5 items-center text-sm">
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Dashboard</button>
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Taxes</button>
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Invoicing</button>
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Reports</button>
          <button class="px-5 py-2 rounded-full bg-[#A9E4C9] text-[#191A19] font-medium shadow-sm">Payment</button>
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Cash Flow</button>
          <button class="px-5 py-2 rounded-full hover:bg-white/10 transition">Projects</button>
        </div>

        <div class="flex items-center gap-4">
          <div class="flex items-center gap-3 bg-white border-2 border-[#191A19] rounded-full pr-6 pl-1 py-1 shadow-[3px_3px_0px_#191A19]">
            <div class="w-10 h-10 rounded-full border-2 border-[#191A19] overflow-hidden bg-gray-200">
               <img src="https://i.pravatar.cc/150?img=11" alt="Prabal" class="w-full h-full object-cover"/>
            </div>
            <div class="leading-tight">
              <div class="font-bold text-sm">Prabal</div>
              <div class="text-[10px] text-gray-500 font-medium">Financial Manager</div>
            </div>
          </div>
          <button class="w-12 h-12 rounded-full bg-[#FFB385] border-2 border-[#191A19] flex items-center justify-center shadow-[3px_3px_0px_#191A19] hover:translate-y-px hover:shadow-[2px_2px_0px_#191A19] transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </button>
        </div>
      </nav>

      <!-- Stats Header -->
      <div class="flex flex-col lg:flex-row items-center justify-between mb-8 gap-8">
        <div class="flex items-center gap-6">
          <h1 class="text-5xl font-bold leading-tight">Automatic<br/>Payment</h1>
          <div class="relative w-20 h-20">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
              <path class="text-gray-200" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="10 2" />
              <path class="text-[#F2D750]" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="11 100" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center font-bold text-sm">11%</div>
          </div>
        </div>

        <div class="flex gap-16">
          <div>
            <div class="text-sm text-gray-500 mb-1 font-medium">Overall balance</div>
            <div class="text-4xl font-bold flex items-start gap-1">990,815<span class="text-xl">$</span></div>
          </div>
          <div>
            <div class="text-sm text-gray-500 mb-1 font-medium">Monthly profits</div>
            <div class="text-4xl font-bold flex items-start gap-1">170,520<span class="text-xl">$</span></div>
          </div>
          <div>
            <div class="text-sm text-gray-500 mb-1 font-medium">Monthly payments</div>
            <div class="text-4xl font-bold flex items-start gap-1">64,520<span class="text-xl">$</span></div>
          </div>
        </div>
      </div>

      <!-- Categories Filter -->
      <div class="flex flex-wrap justify-between items-center mb-8 gap-4">
        <div class="flex flex-wrap gap-3">
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">All</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">Salary</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">Taxes</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] bg-[#A9E4C9] font-medium text-sm shadow-[2px_2px_0px_#191A19]">Software</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">Promotion</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">Rent</button>
          <button class="px-5 py-2 rounded-full border-2 border-[#191A19] font-medium text-sm hover:bg-gray-100">Cleaning</button>
          <button class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center font-bold text-xl hover:bg-[#ff9f66]">+</button>
        </div>
        <div class="flex gap-3">
          <button class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center shadow-[2px_2px_0px_#191A19] hover:translate-y-px hover:shadow-[1px_1px_0px_#191A19] transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          </button>
          <button class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center shadow-[2px_2px_0px_#191A19] hover:translate-y-px hover:shadow-[1px_1px_0px_#191A19] transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6">

        <!-- Purple Card -->
        <div class="bg-[#C7ADF3] rounded-[32px] p-6 pb-8 flex flex-col justify-between">

          <div class="flex justify-between items-start mb-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center p-2">
                 <img src="https://upload.wikimedia.org/wikipedia/commons/3/33/Figma-logo.svg" alt="Figma" class="w-full h-full object-contain"/>
              </div>
              <div>
                <div class="font-bold text-lg leading-tight">Figma</div>
                <div class="text-xs font-medium opacity-70">Collective use</div>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="flex -space-x-3">
                <img class="w-10 h-10 rounded-full border-2 border-[#191A19]" src="https://i.pravatar.cc/150?img=1" alt=""/>
                <img class="w-10 h-10 rounded-full border-2 border-[#191A19]" src="https://i.pravatar.cc/150?img=2" alt=""/>
                <img class="w-10 h-10 rounded-full border-2 border-[#191A19]" src="https://i.pravatar.cc/150?img=3" alt=""/>
                <img class="w-10 h-10 rounded-full border-2 border-[#191A19]" src="https://i.pravatar.cc/150?img=4" alt=""/>
                <div class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center font-bold text-sm">+</div>
              </div>
              <div class="flex gap-2">
                <button class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center shadow-[2px_2px_0px_#191A19]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                </button>
                <button class="w-10 h-10 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center shadow-[2px_2px_0px_#191A19]">
                   <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <!-- Calendar -->
            <div class="bg-[#191A19] rounded-[24px] p-5 text-white relative">
               <div class="absolute -top-3 left-[20%] w-[60%] h-px bg-[#191A19]"></div>
               <div class="absolute -top-[15px] left-[20%] w-2 h-2 rounded-full bg-[#191A19]"></div>
               <div class="absolute -top-[15px] right-[20%] w-2 h-2 rounded-full bg-[#191A19]"></div>
               <div class="absolute -top-[15px] right-[-60%] w-[80%] h-px bg-[#191A19] hidden md:block"></div>
               <div class="absolute -top-[15px] right-[-60%] w-2 h-2 rounded-full bg-white border-2 border-[#191A19] hidden md:block"></div>

              <div class="text-sm font-medium mb-3">Date of payment</div>
              <div class="grid grid-cols-7 gap-1 text-center text-xs opacity-60">
                <div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div><div>7</div>
                <div>8</div><div>9</div><div>10</div><div>11</div><div>12</div><div>13</div><div>14</div>
              </div>
              <div class="grid grid-cols-7 gap-1 text-center text-xs mt-2 font-bold">
                <div class="opacity-60">15</div><div class="opacity-60">16</div>
                <div class="bg-[#A9E4C9] text-[#191A19] rounded-full w-6 h-6 flex items-center justify-center mx-auto">17</div>
                <div class="opacity-60">18</div><div class="opacity-60">19</div><div class="opacity-60">20</div><div class="opacity-60">21</div>
                <div class="opacity-60">22</div><div class="opacity-60">23</div><div class="opacity-60">24</div><div class="opacity-60">25</div><div class="opacity-60">26</div><div class="opacity-60">27</div><div class="opacity-60">28</div>
                <div class="opacity-60">29</div><div class="opacity-60">30</div><div class="opacity-60">31</div>
              </div>
            </div>

            <!-- Payment Plan -->
            <div class="bg-[#191A19] rounded-[24px] p-5 text-white">
              <div class="text-sm font-medium mb-3">Payment plan</div>
              <div class="flex gap-2 mb-3">
                <button class="px-3 py-1.5 rounded-full border border-gray-600 text-xs text-gray-300">Professional</button>
                <button class="px-3 py-1.5 rounded-full border border-gray-600 text-xs text-gray-300">Organization</button>
              </div>
              <button class="px-5 py-1.5 rounded-full bg-[#A9E4C9] text-[#191A19] text-xs font-bold w-fit mb-3">Enterprise</button>
              <div class="flex items-end gap-1">
                <div class="text-3xl font-bold flex items-start">75<span class="text-lg">$</span></div>
                <div class="text-sm text-gray-400 mb-1">/ personal user</div>
              </div>
            </div>

            <!-- Pay From -->
            <div class="bg-[#F6DB95] rounded-[24px] p-5">
              <div class="text-sm font-medium mb-4">Pay from</div>
              <div class="flex items-end h-16 gap-2 mb-3">
                 <div class="flex-1 flex flex-col justify-end">
                    <div class="text-[10px] font-bold text-center mb-1">18,718$</div>
                    <div class="bg-white/40 rounded-t-lg h-6"></div>
                 </div>
                 <div class="flex-1 flex flex-col justify-end">
                    <div class="text-[10px] font-bold text-center mb-1">34,511$</div>
                    <div class="bg-[#191A19] rounded-t-lg h-12"></div>
                 </div>
                 <div class="flex-[1.5] flex flex-col justify-end">
                    <div class="text-[10px] font-bold text-center mb-1">110,090$</div>
                    <div class="bg-[#B9A675] rounded-t-lg h-16"></div>
                 </div>
              </div>
              <div class="flex gap-1.5">
                <div class="flex-1 text-center py-1 rounded-full border border-[#191A19] text-[10px] font-bold">Venmo</div>
                <div class="flex-1 text-center py-1 rounded-full bg-[#191A19] text-white text-[10px] font-bold">Wise</div>
                <div class="flex-[1.5] text-center py-1 rounded-full border border-[#191A19] text-[10px] font-bold">PayPal</div>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap justify-between items-end">
            <div>
              <div class="text-xs font-medium mb-1 opacity-70">Payment details</div>
              <div class="text-2xl font-bold flex items-start">18<span class="text-sm mt-0.5">th</span><span class="text-sm font-medium opacity-70 mt-1 ml-1">/ month</span></div>
            </div>
            <div>
              <div class="text-xs font-medium mb-1 opacity-70 flex items-center gap-1">Number users <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg></div>
              <div class="text-2xl font-bold">5</div>
            </div>
            <div>
              <div class="text-xs font-medium mb-1 opacity-70">Payment amount</div>
              <div class="text-2xl font-bold flex items-start">375<span class="text-sm mt-0.5">$</span></div>
            </div>
            <div>
              <div class="text-xs font-medium mb-1 opacity-70">Payment method</div>
              <div class="text-2xl font-bold">Wise</div>
            </div>
            <button class="w-12 h-12 rounded-full border-2 border-[#191A19] bg-[#FFB385] flex items-center justify-center shadow-[2px_2px_0px_#191A19]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </button>
          </div>
        </div>

        <!-- Right Column Cards -->
        <div class="flex flex-col gap-4">
          <!-- Unsplash Card -->
          <div class="bg-[#D9C6F6] rounded-[24px] p-5 flex flex-col justify-between flex-1">
            <div class="flex justify-between items-start mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center p-2">
                  <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M10 9V0h12v9H10zm12 5h10v18H0V14h10v9h12v-9z"/></svg>
                </div>
                <div class="font-bold text-sm leading-tight">Unsplash<br/>Images</div>
              </div>
              <button class="w-8 h-8 rounded-full border border-[#191A19] flex items-center justify-center hover:bg-white/30">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
              </button>
            </div>
            <div>
              <div class="text-[10px] font-medium opacity-70 mb-1">Monthly, every 17th</div>
              <div class="flex justify-between items-end">
                <div class="text-3xl font-bold flex items-start">200<span class="text-sm mt-1">$</span></div>
                <div class="flex items-center gap-2 bg-[#191A19] rounded-full p-1 border border-[#191A19]">
                   <div class="text-white text-xs px-2 opacity-50">&times;</div>
                   <div class="w-6 h-6 rounded-full bg-[#FFB385] flex items-center justify-center text-[#191A19]">
                     <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                   </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Dropbox Card -->
          <div class="bg-[#D9C6F6] rounded-[24px] p-5 flex flex-col justify-between flex-1">
            <div class="flex justify-between items-start mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center p-2 text-blue-600">
                  <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M8 2.4l8 5.1-8 5.1-8-5.1 8-5.1zm16 0l8 5.1-8 5.1-8-5.1 8-5.1zM0 17.7l8-5.1 8 5.1-8 5.1-8-5.1zm24-5.1l8 5.1-8 5.1-8-5.1 8-5.1zM8 24.5l8-5.1 8 5.1-8 5.1-8-5.1z"/></svg>
                </div>
                <div class="font-bold text-sm leading-tight">Dropbox<br/>Storage</div>
              </div>
              <button class="w-8 h-8 rounded-full border border-[#191A19] flex items-center justify-center hover:bg-white/30">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
              </button>
            </div>
            <div>
              <div class="text-[10px] font-medium opacity-70 mb-1">Annually, January 3</div>
              <div class="flex justify-between items-end">
                <div class="text-3xl font-bold flex items-start">2999<span class="text-sm mt-1">$</span></div>
                <div class="flex items-center gap-2 bg-[#191A19] rounded-full p-1 border border-[#191A19]">
                   <div class="text-white text-xs px-2 opacity-50">&times;</div>
                   <div class="w-6 h-6 rounded-full bg-[#FFB385] flex items-center justify-center text-[#191A19]">
                     <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                   </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Small Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
        <!-- 3D Warehouse -->
        <div class="bg-[#D9C6F6] rounded-full p-2 pr-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
             <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-blue-500">
               <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
             </div>
             <div class="font-bold text-xs leading-tight">3D<br/>Warehouse</div>
          </div>
          <button class="w-7 h-7 rounded-full border border-[#191A19] flex items-center justify-center hover:bg-white/30">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          </button>
        </div>
        <!-- Linkedin Learning -->
        <div class="bg-[#D9C6F6] rounded-full p-2 pr-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
             <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xs">in</div>
             <div class="font-bold text-xs leading-tight">Linkedin<br/>Learning</div>
