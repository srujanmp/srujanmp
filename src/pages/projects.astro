---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TechTags from '../components/TechTags.astro';
import coeditShot from '../assets/projects/coedit.png';
import spyderShot from '../assets/projects/spyderspace.png';
import eventhubShot from '../assets/projects/eventhub.png';
import foodShot from '../assets/projects/food-platform.png';
import endlessShot from '../assets/projects/endless-worlds.png';

// Rebuilt from each repo's own UI source, so a project can show its interface.
const shots: Record<string, ImageMetadata> = {
  coedit: coeditShot,
  spyderspace: spyderShot,
  'event-hub': eventhubShot,
  'food-ordering': foodShot,
  endlessworlds: endlessShot,
};

const allProjects = await getCollection('projects');
allProjects.sort((a, b) => parseInt(b.data.year) - parseInt(a.data.year));

const rendered = await Promise.all(
  allProjects.map(async (project) => ({ project, Content: (await render(project)).Content }))
);
---

<Layout
  title="Projects - Srujan M Padmashali"
  description="Distributed backends, real-time apps, an offline mesh emergency network and an AI-driven game. Built in Go, Node.js, Flutter and Godot."
>
  <header class="pt-4 pb-14 sm:pb-20">
    <p class="eyebrow mb-5" data-rise="1">{allProjects.length} builds · 2024 - 2026</p>
    <h1 class="display text-[clamp(2.5rem,8vw,4.5rem)] text-ink mb-6" data-rise="2">Projects</h1>
    <p class="text-lg text-ink-2 max-w-2xl leading-relaxed" data-rise="3">
      The problems I created and put them on GitHub
    </p>
  </header>

  <div class="flex flex-col">
    {
      rendered.map(({ project, Content }, index) => {
        const link = project.data.link?.trim();
        return (
          <article
            class="group grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-5 py-10 sm:py-14 border-t border-line"
            data-reveal
          >
            <div class="md:col-span-3">
              <p class="mono text-[11px] text-ink-3 mb-2">
                {String(index + 1).padStart(2, '0')}
              </p>
              <p class="mono text-[13px] text-accent">{project.data.year}</p>
            </div>

            <div class="md:col-span-9 min-w-0">
              <h2 class="display text-2xl sm:text-3xl text-ink mb-5 leading-tight">
                {link ? (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-start gap-2.5 hover:text-accent transition-colors duration-300"
                  >
                    <span>{project.data.title}</span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="w-4 h-4 mt-2.5 shrink-0 opacity-40 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                ) : (
                  project.data.title
                )}
              </h2>

              <div class="prose prose-sm prose-ink max-w-none mb-6">
                <Content />
              </div>

              <TechTags items={project.data.techStack} />

              {shots[project.id] && (
                <div class="mt-6 max-w-[420px] rounded-lg overflow-hidden border border-line bg-canvas-2">
                  <Image
                    src={shots[project.id]}
                    alt={`${project.data.title} interface`}
                    widths={[480, 800]}
                    sizes="(max-width: 640px) 85vw, 420px"
                    loading="lazy"
                    class="w-full h-auto block"
                  />
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="border-t border-line pt-10">
    <a
      href="https://github.com/srujanmp"
      target="_blank"
      rel="noopener noreferrer"
      class="link mono text-[13px] text-ink-2 hover:text-accent transition-colors"
    >
      More on GitHub →
    </a>
  </div>
</Layout>
