---
const navItems = [
  { href: '/', label: 'Profile' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="pt-7 pb-6 sm:pt-10 sm:pb-8">
  <div class="flex items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5 shrink-0" aria-label="Home">
      <img
        src="/mark.png"
        alt=""
        width="32"
        height="32"
        class="w-8 h-8 object-contain shrink-0 transition-opacity duration-300 group-hover:opacity-70"
        aria-hidden="true"
      />
      <span class="mono text-[13px] tracking-tight text-ink-2 hidden sm:inline">srujanmp</span>
    </a>

    <nav class="flex items-center gap-5 sm:gap-8" aria-label="Primary">
      {
        navItems.map((item) => {
          const isActive = item.href === '/' ? path === '/' : path.startsWith(item.href);
          return (
            <a
              href={item.href}
              data-astro-prefetch="hover"
              aria-current={isActive ? 'page' : undefined}
              class={`link mono text-[13px] tracking-tight transition-colors duration-200 ${
                isActive ? 'text-accent' : 'text-ink-2 hover:text-ink'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
