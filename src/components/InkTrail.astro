---
/**
 * Halftone dot field + pixel brush.
 *
 * A faint dot grid sits on the paper at all times. Dots near the pointer swell
 * and warm toward the accent, and the field reacts harder over links, so the
 * cursor reads as a light rather than a pen. Hold the left button and drag to
 * stamp grid-snapped pixels that spring in and fade out.
 *
 * Drawn behind the page content, so it stays texture instead of scribble.
 */
---

<canvas id="ink-trail" aria-hidden="true"></canvas>

<style>
  #ink-trail {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    #ink-trail {
      display: none;
    }
  }
</style>

<script>
  const GRID = 24; // dot spacing in CSS px
  const WAKE = 132; // radius the pointer wakes dots within
  const LIFETIME = 2400; // how long a stamped node lives, ms
  const LINK_MS = 230; // how long a connecting edge takes to draw, ms
  const MAX_MARKS = 4000; // hard cap (raised for snake intro)

  const INK = [23, 22, 19] as const; // --color-ink
  const ACCENT = [194, 65, 12] as const; // --color-accent

  /**
   * A stamped cell. `from` is the node it links back to, which is what turns
   * a series of clicks (or a drag) into one connected run instead of a set of
   * unrelated blips. It stays null for the intro flood-fill and for the first
   * stamp of a fresh run.
   */
  type Mark = {
    gx: number;
    gy: number;
    x: number; // page-space centre, cached so render() doesn't recompute
    y: number;
    born: number;
    from: Mark | null;
  };

  const smoothstep = (x: number) => {
    const t = Math.max(0, Math.min(1, x));
    return t * t * (3 - 2 * t);
  };

  // Decelerating draw for the connecting edge.
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  const teardown = () => {
    const prev = window.__inkTrail;
    if (!prev) return;
    prev.dispose();
    window.__inkTrail = undefined;
  };

  const setup = () => {
    const fine = window.matchMedia('(pointer: fine)').matches;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.getElementById('ink-trail');

    if (!fine || still || !(canvas instanceof HTMLCanvasElement)) {
      teardown();
      return;
    }

    if (window.__inkTrail?.canvas === canvas) return;
    teardown();

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Ordered so edges can be drawn between consecutive stamps.
    let marks: Mark[] = [];
    let lastMark: Mark | null = null;
    let dpr = 1;
    let pattern: CanvasPattern | null = null;
    let drawing = false;
    let inside = false;
    let px = 0; // pointer, viewport coords
    let py = 0;
    let lastX = 0; // last stamped point, page coords
    let lastY = 0;
    let hot = 0; // eased 0..1, how "live" the field is (pointer over a link)
    let hotTarget = 0;
    let raf = 0;

    /** One tile holding a single dot, repeated across the viewport. */
    const buildPattern = () => {
      const size = Math.max(1, Math.round(GRID * dpr));
      const tile = document.createElement('canvas');
      tile.width = size;
      tile.height = size;
      const tctx = tile.getContext('2d');
      if (!tctx) return;

      tctx.fillStyle = `rgba(${INK[0]}, ${INK[1]}, ${INK[2]}, 0.085)`;
      tctx.beginPath();
      tctx.arc(size / 2, size / 2, Math.max(0.6, 1.05 * dpr), 0, Math.PI * 2);
      tctx.fill();

      pattern = ctx.createPattern(tile, 'repeat');
    };

    const resize = () => {
      dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildPattern();
    };

    /**
     * Ink the grid cell containing this page-space point.
     * `link` false is used by the intro, which fills the whole page and would
     * otherwise web every cell to the one stamped before it.
     */
    const stamp = (pageX: number, pageY: number, now: number, link = true) => {
      const gx = Math.floor(pageX / GRID);
      const gy = Math.floor(pageY / GRID);

      // Skip a repeat of the cell we are already sitting on, so a slow drag
      // doesn't pile up zero-length edges on one square.
      if (link && lastMark && lastMark.gx === gx && lastMark.gy === gy) return;

      // Only chain onto the previous node while it is still on screen -
      // after everything has faded, the next click starts a fresh run.
      const from = link && lastMark && now - lastMark.born < LIFETIME ? lastMark : null;

      const mark: Mark = {
        gx,
        gy,
        x: gx * GRID + GRID / 2,
        y: gy * GRID + GRID / 2,
        born: now,
        from,
      };

      marks.push(mark);
      if (link) lastMark = mark;

      if (marks.length > MAX_MARKS) marks = marks.slice(-MAX_MARKS);
    };

    const onDown = (event: PointerEvent) => {
      if (event.button !== 0) return;
      if (event.target instanceof Element && event.target.closest('a, button, input, textarea, select')) return;
      drawing = true;
      lastX = event.pageX;
      lastY = event.pageY;
      stamp(lastX, lastY, performance.now());
    };

    const onMove = (event: PointerEvent) => {
      px = event.clientX;
      py = event.clientY;
      inside = true;
      if (!drawing) return;

      const x = event.pageX;
      const y = event.pageY;
      const dx = x - lastX;
      const dy = y - lastY;

      // Walk the segment so a fast drag leaves a continuous run of cells.
      const steps = Math.min(64, Math.max(1, Math.ceil(Math.hypot(dx, dy) / (GRID * 0.5))));
      const now = performance.now();
      for (let i = 1; i <= steps; i += 1) {
        stamp(lastX + (dx * i) / steps, lastY + (dy * i) / steps, now);
      }

      lastX = x;
      lastY = y;
    };

    const stop = () => {
      drawing = false;
    };

    const onLeave = () => {
      inside = false;
      drawing = false;
    };

    const isLive = (node: EventTarget | null) =>
      node instanceof Element && !!node.closest('a[href], button');

    const onOver = (event: PointerEvent) => {
      if (isLive(event.target)) hotTarget = 1;
    };

    const onOut = (event: PointerEvent) => {
      if (isLive(event.target) && !isLive(event.relatedTarget)) hotTarget = 0;
    };

    const render = (now: number) => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const sx = window.scrollX;
      const sy = window.scrollY;

      hot += (hotTarget - hot) * 0.12;

      ctx.clearRect(0, 0, w, h);

      // --- resting dot field, anchored to the page so it scrolls with content
      if (pattern) {
        const g = GRID * dpr;
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.translate(-((((sx * dpr) % g) + g) % g), -((((sy * dpr) % g) + g) % g));
        ctx.fillStyle = pattern;
        ctx.fillRect(0, 0, canvas.width + g, canvas.height + g);
        ctx.restore();
      }

      // --- dots woken by the pointer
      if (inside) {
        const pgx = px + sx;
        const pgy = py + sy;
        const radius = WAKE * (1 + hot * 0.3);

        const fromX = Math.floor((pgx - radius) / GRID);
        const toX = Math.floor((pgx + radius) / GRID);
        const fromY = Math.floor((pgy - radius) / GRID);
        const toY = Math.floor((pgy + radius) / GRID);

        for (let gx = fromX; gx <= toX; gx += 1) {
          for (let gy = fromY; gy <= toY; gy += 1) {
            const cx = gx * GRID + GRID / 2;
            const cy = gy * GRID + GRID / 2;
            const d = Math.hypot(cx - pgx, cy - pgy);
            if (d > radius) continue;

            const falloff = (1 - d / radius) ** 2;
            const screenX = cx - sx;
            const screenY = cy - sy;
            if (screenX < -GRID || screenX > w + GRID) continue;
            if (screenY < -GRID || screenY > h + GRID) continue;

            // Breathing ripple, so a parked pointer still has life in it.
            const pulse = 1 + 0.16 * Math.sin(now / 320 - d / 46);
            const r = (1.05 + falloff * (2.5 + hot * 1.7)) * pulse;
            const mix = Math.min(1, falloff * 1.3 + hot * 0.45);

            const cr = Math.round(INK[0] + (ACCENT[0] - INK[0]) * mix);
            const cg = Math.round(INK[1] + (ACCENT[1] - INK[1]) * mix);
            const cb = Math.round(INK[2] + (ACCENT[2] - INK[2]) * mix);

            ctx.fillStyle = `rgba(${cr}, ${cg}, ${cb}, ${0.1 + falloff * 0.62})`;
            ctx.beginPath();
            ctx.arc(screenX, screenY, r, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      // --- brush: a connected run of grid-snapped pixels
      // Drop anything past its lifetime in one pass, keeping order intact.
      if (marks.length && now - marks[0].born > LIFETIME) {
        marks = marks.filter((m) => now - m.born <= LIFETIME);
      }
      if (lastMark && now - lastMark.born > LIFETIME) lastMark = null;

      const A = `${ACCENT[0]}, ${ACCENT[1]}, ${ACCENT[2]}`;

      // Pass 1: the edges, so every dot sits on top of its own wiring.
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (const mark of marks) {
        const src = mark.from;
        if (!src) continue;

        const age = now - mark.born;
        const life = age / LIFETIME;
        const fade = life < 0.4 ? 1 : 1 - smoothstep((life - 0.4) / 0.6);
        if (fade <= 0.01) continue;

        const ax = src.x - sx;
        const ay = src.y - sy;
        const bx = mark.x - sx;
        const by = mark.y - sy;

        // Cheap viewport reject for the whole segment.
        if (Math.max(ax, bx) < -GRID || Math.min(ax, bx) > w + GRID) continue;
        if (Math.max(ay, by) < -GRID || Math.min(ay, by) > h + GRID) continue;

        // The line grows from the previous node towards this one.
        const p = easeOut(Math.min(1, age / LINK_MS));
        const hx = ax + (bx - ax) * p;
        const hy = ay + (by - ay) * p;

        // Kept deliberately faint - the pixels are the subject, the wiring
        // between them is just a hint. Soft halo plus a thin core, no
        // shadowBlur, which would be far too expensive at this segment count.
        ctx.strokeStyle = `rgba(${A}, ${0.05 * fade})`;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(hx, hy);
        ctx.stroke();

        ctx.strokeStyle = `rgba(${A}, ${0.18 * fade})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(hx, hy);
        ctx.stroke();

        // Spark riding the head while the edge is still drawing.
        if (p < 1) {
          ctx.fillStyle = `rgba(${A}, ${0.34 * fade})`;
          ctx.beginPath();
          ctx.arc(hx, hy, 2.1, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Pass 2: the pixels themselves.
      for (const mark of marks) {
        const age = now - mark.born;
        const cx = mark.x - sx;
        const cy = mark.y - sy;
        if (cx < -GRID || cx > w + GRID || cy < -GRID || cy > h + GRID) continue;

        const life = age / LIFETIME;
        const fade = life < 0.4 ? 1 : 1 - smoothstep((life - 0.4) / 0.6);
        if (fade <= 0.01) continue;

        // A linked pixel waits for its edge to reach it before it lands, so
        // the run reads as connect-then-arrive rather than everything at once.
        const delay = mark.from ? LINK_MS * 0.55 : 0;
        const t = Math.max(0, age - delay) / 1000;

        // Damped spring: starts at 0, overshoots ~1.3, settles at 1.
        const scale = Math.max(0, Math.min(1.5, 1 - Math.exp(-9 * t) * Math.cos(14 * t)));
        if (scale <= 0.01) continue;

        const size = GRID * 0.62 * scale;
        const half = size / 2;

        ctx.fillStyle = `rgba(${A}, ${0.3 * fade})`;
        ctx.beginPath();
        if (typeof ctx.roundRect === 'function') {
          ctx.roundRect(cx - half, cy - half, size, size, 3);
        } else {
          ctx.rect(cx - half, cy - half, size, size);
        }
        ctx.fill();
      }

      raf = requestAnimationFrame(render);
    };

    resize();

    /* ── Virus intro: flood-fill spread from top-left across entire page ── */
    const snakeIntro = () => {
      const cols = Math.ceil(window.innerWidth / GRID);
      const rows = Math.ceil(document.documentElement.scrollHeight / GRID);

      // Build cells sorted by Manhattan distance from origin + random jitter
      const cells: { gx: number; gy: number; dist: number }[] = [];
      for (let col = 0; col < cols; col++) {
        for (let row = 0; row < rows; row++) {
          const dist = col + row + Math.random() * 1.8; // jitter for organic feel
          cells.push({ gx: col, gy: row, dist });
        }
      }
      cells.sort((a, b) => a.dist - b.dist);

      const duration = 1400;
      const maxDist = cells[cells.length - 1].dist;

      cells.forEach((cell) => {
        const delay = (cell.dist / maxDist) * duration;
        setTimeout(() => {
          stamp(cell.gx * GRID + GRID / 2, cell.gy * GRID + GRID / 2, performance.now(), false);
        }, delay);
      });
    };

    // Only run on first page load, not on view transitions
    if (!window.__inkSnakeDone) {
      window.__inkSnakeDone = true;
      snakeIntro();
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerup', stop, { passive: true });
    window.addEventListener('pointercancel', stop, { passive: true });
    window.addEventListener('pointerover', onOver, { passive: true });
    window.addEventListener('pointerout', onOut, { passive: true });
    window.addEventListener('blur', stop);
    document.addEventListener('pointerleave', onLeave);
    raf = requestAnimationFrame(render);

    window.__inkTrail = {
      canvas,
      dispose() {
        cancelAnimationFrame(raf);
        window.removeEventListener('resize', resize);
        window.removeEventListener('pointerdown', onDown);
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', stop);
        window.removeEventListener('pointercancel', stop);
        window.removeEventListener('pointerover', onOver);
        window.removeEventListener('pointerout', onOut);
        window.removeEventListener('blur', stop);
        document.removeEventListener('pointerleave', onLeave);
      },
    };
  };

  // Client-side navigation.
  document.addEventListener('astro:page-load', setup);

  // First load: `astro:page-load` only fires once the ClientRouter is running,
  // so without this the effect can silently never start.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup, { once: true });
  } else {
    setup();
  }
</script>
